# Скопируй этот файл в .env и заполни. Файл .env никому не показывай и не выкладывай.

# Токен от @BotFather
BOT_TOKEN=

# Твой Telegram ID (узнать: @userinfobot). Несколько — через запятую.
# Сюда приходят уведомления о покупках, и только этим людям доступны /stats, /reload, /refund
ADMIN_IDS=

# Способы оплаты через запятую — человек выберет сам:
#   tribute  — картой через Tribute (ссылки tribute_url в content.yaml)
#   transfer — переводом на карту, покупатель присылает чек, ты подтверждаешь
#   stars    — звёздами Telegram
#   yookassa — картой или СБП через ЮKassa
PAYMENT_METHODS=tribute,transfer

# Реквизиты для перевода. Каждая строка — с новой строки через \n, всё в кавычках.
TRANSFER_DETAILS="Карта: 0000 0000 0000 0000\nПолучатель: Имя Ф.\nИли по СБП: +7 000 000-00-00, банк …"

# Tribute: API-ключ из кабинета автора. Нужен, чтобы бот узнавал о покупках через Tribute.
# Без него оплата работает, но покупки не попадут в «Мои покупки» и статистику.
TRIBUTE_API_KEY=
# Куда Tribute шлёт уведомления: бот слушает этот порт, снаружи его открывает Caddy (см. README)
TRIBUTE_WEBHOOK_PORT=8080

# Нужны только для yookassa — берутся в личном кабинете ЮKassa → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Часовой пояс для прогрева: сообщения уходят только в дневные часы (nurture_hours в content.yaml)
TIMEZONE=Europe/Moscow

# Прокси только для связи с Telegram — если с сервера api.telegram.org недоступен.
# Проверка: sudo bash /opt/moy-den/sales-bot/deploy/check.sh
# Формат: socks5://логин:пароль@хост:порт  или  http://хост:порт
TELEGRAM_PROXY=
