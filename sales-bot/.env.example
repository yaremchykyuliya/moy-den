# Скопируй этот файл в .env и заполни. Файл .env никому не показывай и не выкладывай.

# Токен от @BotFather
BOT_TOKEN=

# Твой Telegram ID (узнать: @userinfobot). Несколько — через запятую.
# Сюда приходят уведомления о покупках, и только этим людям доступны /stats, /reload, /refund
ADMIN_IDS=

# Способ оплаты: stars (звёзды Telegram) или yookassa (рубли на твой счёт)
PAYMENT_PROVIDER=stars

# Нужны только для yookassa — берутся в личном кабинете ЮKassa → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Часовой пояс для прогрева: сообщения уходят только в дневные часы (nurture_hours в content.yaml)
TIMEZONE=Europe/Moscow
